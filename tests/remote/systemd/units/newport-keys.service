[Unit]
Description=Install the test client key
Before=ssh.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -ec 'for u in fixture keeper; do install -d -m 700 -o $u -g $u /home/$u/.ssh; install -m 600 -o $u -g $u /fixture-key/client.pub /home/$u/.ssh/authorized_keys; done'

[Install]
WantedBy=multi-user.target
