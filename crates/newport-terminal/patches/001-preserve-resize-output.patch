         self.cursor.y = 0;
         self.cursorChangePin(pin);
 
@@ -2133,6 +2134,7 @@ pub inline fn resize(
             .pin = self.cursor.page_pin,
         },
         .pull_scrollback = opts.pull_scrollback,
