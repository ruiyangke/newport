+            sc.x = @min(p.x, opts.cols - 1);
             sc.y = 0;
             sc.pending_wrap = false;
         }
@@ -12666,3 +12663,58 @@ test "Screen: selectLine does not join lines across a recycled row" {
         try testing.expectEqualStrings("world", contents);
     }
 }
+
+test "Screen: resize retains styled trailing output only with history" {
+    for ([_]bool{ false, true }) |history_enabled| {
+        var s = try init(std.testing.io, std.testing.allocator, .{
+            .cols = 10,
+            .rows = 3,
+            .max_scrollback_bytes = if (history_enabled) null else 0,
+        });
+        defer s.deinit();
+        try s.testWriteString("a\nb");
+        const last = s.pages.getCell(.{ .active = .{ .x = 1, .y = 2 } }).?;
+        last.cell.* = .{
+            .content_tag = .bg_color_rgb,
+            .content = .{ .color_rgb = .{ .r = 255, .g = 0, .b = 0 } },
+        };
+        s.cursorAbsolute(1, 0);
+        try s.resize(.{ .cols = 10, .rows = 2 });
+        try std.testing.expectEqual(@as(usize, if (history_enabled) 3 else 2), s.pages.total_rows);
+        if (history_enabled) {
+            const retained = s.pages.getCell(.{ .active = .{ .x = 1, .y = 1 } }).?;
+            try std.testing.expectEqual(.bg_color_rgb, retained.cell.content_tag);
+            try std.testing.expectEqual(@as(u8, 255), retained.cell.content.color_rgb.r);
+        }
+    }
+}
+
+test "Screen: resize clamps cursor rows without losing columns" {
+    for ([_]size.CellCountInt{ 10, 3 }) |cols| {
+        var s = try init(std.testing.io, std.testing.allocator, .{
+            .cols = 10,
+            .rows = 3,
+            .max_scrollback_bytes = null,
+        });
+        defer s.deinit();
+        try s.testWriteString("a\nb\nc");
+        s.cursorAbsolute(4, 0);
+        s.saved_cursor = .{
+            .x = 4,
+            .y = 0,
+            .style = .{},
+            .protected = false,
+            .pending_wrap = false,
+            .origin = false,
+            .charset = s.charset,
+        };
+        try s.resize(.{ .cols = cols, .rows = 2, .reflow = false });
+        try std.testing.expectEqual(@min(@as(size.CellCountInt, 4), cols - 1), s.cursor.x);
+        try std.testing.expectEqual(@as(size.CellCountInt, 0), s.cursor.y);
+        try std.testing.expectEqual(s.cursor.x, s.saved_cursor.?.x);
+        try std.testing.expectEqual(@as(size.CellCountInt, 0), s.saved_cursor.?.y);
+        const text = try s.dumpStringAlloc(std.testing.allocator, .{ .screen = .{} });
+        defer std.testing.allocator.free(text);
+        try std.testing.expectEqualStrings("a\nb\nc", text);
+    }
+}
