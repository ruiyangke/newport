diff --git a/src/terminal/PageList.zig b/src/terminal/PageList.zig
index bd76f6f..5062005 100644
--- a/src/terminal/PageList.zig
+++ b/src/terminal/PageList.zig
@@ -1246,6 +1246,11 @@ pub const Resize = struct {
     /// rows back and would otherwise get out of sync with us.
     pull_scrollback: bool = true,
 
+    /// Preserve rows containing only styling when shrinking the active area.
+    /// History-enabled screens retain these as output; screens without history
+    /// may trim them to keep their remaining text visible.
+    preserve_styled_blank_rows: bool = false,
+
     pub const Cursor = struct {
         x: size.CellCountInt,
         y: size.CellCountInt,
@@ -2876,7 +2881,7 @@ fn resizeWithoutReflow(self: *PageList, opts: Resize) Allocator.Error!void {
                 // behavior because it seemed fine in an ocean of differing behavior
                 // between terminal apps. I'm completely open to changing it as long
                 // as resize behavior isn't regressed in a user-hostile way.
-                const trimmed = self.trimTrailingBlankRows(self.rows - rows);
+                const trimmed = self.trimTrailingBlankRows(self.rows - rows, opts.preserve_styled_blank_rows);
 
                 // Account for our trimmed rows in the total row cache
                 self.total_rows -= trimmed;
@@ -3196,8 +3201,8 @@ fn trailingBlankLines(
 }
 
 /// Trims up to max trailing blank rows from the pagelist and returns the
-/// number of rows trimmed. A blank row is any row with no text (but may
-/// have styling).
+/// number of rows trimmed. Without preservation, a blank row has no text
+/// but may have styling; with preservation, every cell must be empty.
 ///
 /// IMPORTANT: This function does NOT update `total_rows`. It returns the
 /// number of rows trimmed, and the caller is responsible for decrementing
@@ -3205,6 +3210,7 @@ fn trailingBlankLines(
 fn trimTrailingBlankRows(
     self: *PageList,
     max: size.CellCountInt,
+    preserve_styled: bool,
 ) size.CellCountInt {
     var trimmed: size.CellCountInt = 0;
     var invalidated_node: ?*List.Node = null;
@@ -3213,8 +3219,9 @@ fn trimTrailingBlankRows(
     while (it.next()) |row_pin| {
         const cells = row_pin.cells(.all);
 
-        // If the row has any text then we're done.
-        if (pagepkg.Cell.hasTextAny(cells)) return trimmed;
+        if (preserve_styled) {
+            for (cells) |cell| if (!cell.isEmpty()) return trimmed;
+        } else if (pagepkg.Cell.hasTextAny(cells)) return trimmed;
 
         // If our tracked pins are in this row then we cannot trim it
         // because it implies some sort of importance. If we trimmed this
@@ -11919,7 +11926,7 @@ test "PageList trailing row truncation renews page generation" {
 
     const node = s.pages.last.?;
     const old_serial = node.serial;
-    const trimmed = s.trimTrailingBlankRows(1);
+    const trimmed = s.trimTrailingBlankRows(1, false);
     s.total_rows -= trimmed;
     try testing.expectEqual(@as(size.CellCountInt, 1), trimmed);
     try testing.expect(!s.nodeIsValid(node, old_serial));
@@ -20800,3 +20807,26 @@ test "PageList memory pool fast path does not allocate" {
     try testing.expectEqual(extra.len, counting.allocations);
     try testing.expectEqual(0, counting.deallocations);
 }
+
+test "PageList resize styled trailing row preservation is explicit" {
+    for ([_]bool{ false, true }) |preserve| {
+        var s = try init(std.testing.allocator, .{ .cols = 5, .rows = 3 });
+        defer s.deinit();
+        const last = s.getCell(.{ .active = .{ .x = 1, .y = 2 } }).?;
+        last.cell.* = .{
+            .content_tag = .bg_color_palette,
+            .content = .{ .color_palette = .{ .data = 42 } },
+        };
+        try s.resize(.{ .rows = 2, .preserve_styled_blank_rows = preserve });
+        try std.testing.expectEqual(@as(usize, if (preserve) 3 else 2), s.total_rows);
+        if (preserve) {
+            const retained = s.getCell(.{ .active = .{ .x = 1, .y = 1 } }).?;
+            try std.testing.expectEqual(.bg_color_palette, retained.cell.content_tag);
+            try std.testing.expectEqual(@as(u8, 42), retained.cell.content.color_palette.data);
+        } else {
+            try s.resize(.{ .rows = 3 });
+            const cleared = s.getCell(.{ .active = .{ .x = 1, .y = 2 } }).?;
+            try std.testing.expect(cleared.cell.isZero());
+        }
+    }
+}
diff --git a/src/terminal/Screen.zig b/src/terminal/Screen.zig
