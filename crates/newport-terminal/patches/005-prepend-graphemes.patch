+/// Whether GB9b can join an ASCII character to the cell before the cursor.
+/// Resolve the actual cell rather than previous_char, which survives cursor
+/// movement and need not identify the cell that will receive a continuation.
+fn prependBeforeCursor(self: *Terminal) bool {
+    const screen = self.screens.active;
+    const cursor = &screen.cursor;
+    const right = if (cursor.x > self.scrolling_region.right)
+        self.cols
+    else
+        self.scrolling_region.right + 1;
+    var left: size.CellCountInt = if (self.modes.get(.wraparound))
+        @intFromBool(!cursor.pending_wrap)
+    else if (cursor.x != right - 1) 1 else @intFromBool(cursor.page_cell.codepoint() == 0);
+    if (left > cursor.x) return false;
+    var cell = screen.cursorCellLeft(left);
+    if (cell.wide == .spacer_tail) {
+        if (left == cursor.x) return false;
+        left += 1;
+        cell = screen.cursorCellLeft(left);
+    }
+    var cp = cell.codepoint();
+    if (cp <= 0xFF) return false;
+    if (cell.hasGrapheme()) {
+        const cps = cursor.page_pin.node.page().lookupGrapheme(cell).?;
+        cp = cps[cps.len - 1];
+    }
+    return unicode.table.get(cp).grapheme_break == .prepend;
+}
