+        loops.update(WM_ENTERMENULOOP);
+        assert!(loops.active());
+        assert!(!loops.in_size_move());
+        loops.update(WM_ENTERSIZEMOVE);
+        loops.update(WM_ENTERMENULOOP);
+        loops.update(WM_EXITMENULOOP);
+        loops.update(WM_EXITMENULOOP);
+        assert!(loops.active());
+        assert!(loops.in_size_move());
+        loops.update(WM_EXITSIZEMOVE);
