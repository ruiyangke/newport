+    fn channel_params(
+        id: ChannelId,
+        recipient_channel: u32,
+        recipient_window_size: u32,
+        pending: &'static [u8],
+    ) -> crate::ChannelParams {
+        let mut pending_data = VecDeque::new();
+        if !pending.is_empty() {
+            pending_data.push_back((bytes::Bytes::from_static(pending), None, 0));
+        }
+        crate::ChannelParams {
+            recipient_channel,
+            sender_channel: id,
+            recipient_window_size,
+            sender_window_size: 1 << 20,
+            recipient_maximum_packet_size: 32768,
+            sender_maximum_packet_size: 32768,
+            confirmed: true,
+            wants_reply: false,
+            pending_data,
