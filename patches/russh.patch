+    /// An authenticated session with a channel whose `b"held"` the server's
+    /// window hasn't admitted, and a channel with room.
+    fn session_with_held_channel() -> (
+        Session,
+        tokio::sync::mpsc::Sender<Msg>,
+        tokio::sync::mpsc::UnboundedReceiver<Reply>,
+    ) {
+        let (mut session, sender, replies) = keyboard_interactive_session();
+        for id in [HELD, OPEN] {
+            let (channel_sender, _) = channel(CREDITED_QUEUE);
+            session
+                .channels
+                .insert(id, ChannelRef::credited(channel_sender));
+        }
+        let enc = session.common.encrypted.as_mut().unwrap();
+        enc.state = EncryptedState::Authenticated;
+        enc.channels
+            .insert(HELD, channel_params(HELD, HELD_RECIPIENT, 0, b"held"));
+        enc.channels
+            .insert(OPEN, channel_params(OPEN, OPEN_RECIPIENT, 1 << 20, b""));
