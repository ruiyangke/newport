+        let enc = session.common.encrypted.as_mut().unwrap();
+        enc.state = EncryptedState::Authenticated;
+        let mut pending_data = VecDeque::new();
+        if !pending.is_empty() {
+            pending_data.push_back((bytes::Bytes::from_static(pending), None, 0));
+        }
+        enc.channels.insert(
+            CLOSING_CHANNEL,
+            crate::ChannelParams {
+                recipient_channel: CLOSING_RECIPIENT,
+                sender_channel: CLOSING_CHANNEL,
+                recipient_window_size: 0,
+                sender_window_size: 1024,
+                recipient_maximum_packet_size: 1024,
+                sender_maximum_packet_size: 1024,
+                confirmed: true,
+                wants_reply: false,
+                pending_data,
+                pending_eof: false,
+                pending_close: false,
+            },
+        );
+        session
+    }
+
+    fn written_packet_types(session: &Session) -> Vec<u8> {
+        let write = &session.common.encrypted.as_ref().unwrap().write;
+        let mut types = Vec::new();
+        let mut cursor = 0;
+        while cursor < write.len() {
+            let len = <byteorder::BigEndian as byteorder::ByteOrder>::read_u32(&write[cursor..cursor + 4]) as usize;
+            types.push(write[cursor + 4]);
+            cursor += 4 + len;
+        }
+        types
+    }
+
+    fn peer_close_packet() -> Vec<u8> {
+        let mut packet = vec![msg::CHANNEL_CLOSE];
+        CLOSING_CHANNEL.encode(&mut packet).unwrap();
+        packet
+    }
+
+    /// After the peer's close, nothing more goes out for the channel.
+    fn assert_channel_silent(session: &mut Session) {
+        let before = written_packet_types(session);
+        session
+            .handle_msg(Msg::Channel(
+                CLOSING_CHANNEL,
+                ChannelMsg::Data {
+                    data: bytes::Bytes::from_static(b"late"),
+                },
+            ))
+            .unwrap();
+        session
+            .handle_msg(Msg::Channel(CLOSING_CHANNEL, ChannelMsg::Eof))
+            .unwrap();
+        session
+            .apply_credit(WindowCredit {
+                channel: CLOSING_CHANNEL,
+                bytes: 512,
+            })
+            .unwrap();
+        session
+            .handle_msg(Msg::Channel(CLOSING_CHANNEL, ChannelMsg::Close))
+            .unwrap();
+        let enc = session.common.encrypted.as_mut().unwrap();
+        enc.flush_all_pending().unwrap();
+        assert!(!enc.has_any_pending_data());
+        assert_eq!(written_packet_types(session), before);
+    }
