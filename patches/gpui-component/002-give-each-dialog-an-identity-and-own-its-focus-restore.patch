+    /// Dismiss exactly the captured dialog. A covered dialog may disappear
+    /// without dismissing its successor or restoring focus into the background.
+    pub(crate) fn close_dialog_if(
+        &mut self,
+        focus: &FocusHandle,
+        window: &mut Window,
+        cx: &mut Context<'_, WindowState>,
+    ) -> bool {
+        let Some(index) = self
+            .active_dialogs
+            .iter()
+            .position(|dialog| !dialog.closing && &dialog.focus_handle == focus)
+        else {
+            return false;
+        };
+        let covering = self.active_dialogs[index + 1..]
+            .iter()
+            .position(|dialog| !dialog.closing)
+            .map(|offset| index + 1 + offset);
+        let Some(covering) = covering else {
+            self.close_dialog(window, cx);
+            return true;
+        };
+        // The covering dialog now returns to where the closed one would have.
+        let opener = self.active_dialogs[index].previous_focused_handle.take();
+        self.active_dialogs[covering].previous_focused_handle = opener;
+        self.active_dialogs[index].active.set(false);
+        if self.active_dialogs[index].exit_enabled.get() {
+            Self::begin_dialog_exit(&mut self.active_dialogs[index], window, cx);
+        } else {
+            self.active_dialogs.remove(index);
+        }
+        self.pending_focus_restore = None;
+        cx.notify();
+        true
+    }
