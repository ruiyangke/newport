+                    let submissions = submissions.clone();
+                    dialog
+                        .title("Server")
+                        .child(div().w(px(240.)).h(px(34.)).child(Select::new(&state)))
+                        .on_ok(move |_, _, _| {
+                            submissions.set(submissions.get() + 1);
