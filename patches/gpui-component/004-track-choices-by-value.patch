+                list.set_selected_index(Some(IndexPath::new(1)), window, cx);
+                list.scroll_handle()
+                    .base_handle()
+                    .set_offset(gpui::point(px(0.), px(-28.)));
+            });
+            state.update(cx, |state, cx| {
